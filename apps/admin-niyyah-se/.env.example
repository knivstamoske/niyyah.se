# Node environment
NODE_ENV=production

# Database URL for local PostgreSQL (matches credentials in root .env)
# Note: search_path=administrator ensures Better-Auth uses the administrator schema
DATABASE_URL="postgresql://niyyah:niyyah@localhost:5432/niyyah?options=-c%20search_path%3Dadministrator"

# SMTP Configuration (Mailpit for development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=username
SMTP_PASS=password
SMTP_FROM=noreply@niyyah.se

# Better Auth Secret (generate with: openssl rand -base64 32)
AUTH_SECRET=dev-secret-change-in-production-use-openssl-rand-base64-32

# Application Origin URL (required for production)
ORIGIN=http://localhost:8010

# Magic Link Expiry (in seconds)
LINK_EXPIRY=600

# Admin User Credentials (auto-created on startup)
ADMIN_EMAIL=admin@niyyah.se
ADMIN_PASSWORD=change-this
